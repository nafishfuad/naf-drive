# API server environment — copy to .env (never commit real values)

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Public origins — used to build OAuth redirect_uris and post-login bounces
WEB_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# Local dev database (docker compose up postgres) — mirrors Supabase Postgres
DATABASE_URL=postgresql://naf:naf_dev@localhost:54322/naf_drive

# Your Supabase project (https://supabase.com → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional override; defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=

# REQUIRED · 32 random bytes base64 → openssl rand -base64 32
ENVELOPE_MASTER_KEY_B64=

# ── Cloud providers (Phase 1) ────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
#   Authorized redirect URI: ${API_PUBLIC_URL}/v1/connections/callback/google-drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dropbox App Console → Scoped app ("App folder" type recommended)
#   Redirect URI: ${API_PUBLIC_URL}/v1/connections/callback/dropbox
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
