# Web env template — copy to apps/web/.env.local and fill in.
# (Next.js reads env files from apps/web/, NOT the repo root.)
# NEVER commit real values.

# ── Supabase (create free project at https://supabase.com) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── API ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── API server (.env for apps/api) ──────────────────────────────────────────
# PORT=3001
# CORS_ORIGIN=http://localhost:3000
# DATABASE_URL=postgresql://naf:naf_dev@localhost:54322/naf_drive
# SUPABASE_URL=http://localhost:54321  # or your Supabase project URL in prod
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# ENVELOPE_MASTER_KEY_B64=  # 32 random bytes base64 — generate: openssl rand -base64 32
